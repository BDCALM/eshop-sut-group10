{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "build": "node scripts/check-syntax.cjs",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand tests/unit",
    "test:api": "jest --runInBand tests/api",
    "test:smoke": "jest --runInBand tests/smoke",
    "test:harness": "jest --runInBand tests/harness",
    "test:isolation": "node scripts/verify-isolation.cjs",
    "test:coverage": "jest --runInBand --coverage",
    "test:ci": "jest --ci --runInBand --coverage --reporters=default --reporters=jest-junit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "jest-junit": {
    "outputDirectory": "<rootDir>/test-results",
    "outputName": "junit.xml",
    "suiteNameTemplate": "{filename}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}",
    "reportTestSuiteErrors": "true"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "jest": "^30.5.2",
    "jest-junit": "17.0.0",
    "supertest": "^7.3.1"
  }
}
